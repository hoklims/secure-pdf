{
  "name": "@secure-pdf/viewer",
  "version": "1.0.0",
  "description": "React-based secure viewer for SPDF documents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest",
